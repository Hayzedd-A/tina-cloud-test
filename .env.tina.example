# TinaCMS — Visual Blog Editor
# 1. Register free at https://app.tina.io
# 2. Create a project linked to this GitHub repo
# 3. Copy clientId and token here, then rename this file to .env.local

# Public — safe to embed in the browser bundle (used by the admin UI)
NEXT_PUBLIC_TINA_CLIENT_ID=

# Secret — never expose in client code; used server-side by tinacms build
TINA_TOKEN=

# Once these are set:
# - Local editing:  npm run dev:cms  → visit localhost:7080/admin
# - Deploy with admin: docker build --build-arg NEXT_PUBLIC_TINA_CLIENT_ID=... --build-arg TINA_TOKEN=...
